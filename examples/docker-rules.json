[
  {
    "id": "api_dead_e2e_test",
    "name": "API Dead In-Container Recovery E2E Test",
    "severity": "critical",
    "trigger": {
      "type": "http_health",
      "container": "aegira-api-e2e",
      "url": "http://127.0.0.1:18080/health",
      "expected_status": 200,
      "interval_secs": 5
    },
    "error_patterns": [
      "HTTP health check failed"
    ],
    "context_patterns": [
      "aegira-api-e2e",
      "127.0.0.1:18080/health"
    ],
    "remediation": {
      "type": "container_restart",
      "container": "aegira-api-e2e"
    },
    "verification": {
      "type": "container_http_status",
      "container": "aegira-api-e2e",
      "url": "http://127.0.0.1:18080/health",
      "expected_status": 200
    },
    "action": "auto_recover",
    "priority": 20
  },
  {
    "id": "docker_exit_137_e2e_test",
    "name": "Docker Exit 137 Full E2E Recovery Test",
    "severity": "critical",
    "trigger": {
      "type": "docker_exit",
      "container": "aegira-e2e",
      "exit_codes": [137]
    },
    "error_patterns": [
      "Docker container 'aegira-e2e' exited",
      "exit code 137"
    ],
    "context_patterns": [
      "aegira-e2e"
    ],
    "remediation": {
      "type": "command_sequence",
      "commands": [
        "echo E2E_137_COMMAND_1 > /tmp/aegira-137-command-1",
        "test -f /tmp/aegira-137-command-1 && echo E2E_137_COMMAND_2 > /tmp/aegira-137-command-2",
        "docker restart aegira-e2e"
      ],
      "verifications": [
        {
          "type": "command_success",
          "executable": "test",
          "args": ["-f", "/tmp/aegira-137-command-1"]
        },
        {
          "type": "command_success",
          "executable": "test",
          "args": ["-f", "/tmp/aegira-137-command-2"]
        },
        {
          "type": "container_running",
          "container": "aegira-e2e"
        }
      ]
    },
    "verification": {
      "type": "container_running",
      "container": "aegira-e2e"
    },
    "action": "auto_recover",
    "priority": 20
  }
]
